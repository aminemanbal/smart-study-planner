MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studyplanner
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000

# Groq API (for AI study plan, insights, and Pulse coach chatbot)
# Free tier — no credit card required.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_...

