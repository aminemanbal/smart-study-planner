# ── Database ───────────────────────────────────────────────
# Local dev (Atlas blocked on university network):
MONGO_URI=mongodb://localhost:27017/studyplanner
# Production (MongoDB Atlas M0 free tier):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studyplanner

# ── Auth ───────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret

# ── Server ─────────────────────────────────────────────────
# Local only. On Render the PORT is injected automatically — do NOT set it there.
PORT=5000

# Frontend origin(s) allowed by CORS, comma-separated.
# Leave empty in local dev (all origins allowed).
# In production set to your Vercel URL, e.g.:
# CLIENT_URL=https://smart-study-planner.vercel.app
CLIENT_URL=

# ── AI (Groq, free tier — no credit card) ──────────────────
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# Optional overrides for a different OpenAI-compatible provider:
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
